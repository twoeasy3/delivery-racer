{
  "name": "delivery-racer",
  "private": true,
  "version": "1.1.16",
  "type": "module",
  "description": "Delivery Racer: a lane-based 3D delivery racer (three.js, Vite), deployed as a static-assets Cloudflare Worker.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "node scripts/delivery-tests.mjs --fast",
    "test:delivery": "node scripts/delivery-smoke.mjs",
    "test:delivery:quick": "node scripts/delivery-smoke.mjs --quick",
    "lint": "eslint src/delivery scripts"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.27.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "vite": "^8.0.14",
    "wrangler": "^4.149.0"
  }
}
