@@ -277,6 +282,41 @@ Progress.earnedCars = EARNED_CARS;
 // the car a special level earns (undefined for a level with none)
 export const earnedFor = (levelId) => EARNED_CARS.find(car => car.earned.level === levelId);
 
+// ---- Delivery and Nerve (see CONFIG.carStats) ----
+// Each car's character: [nerve, haul]. Nerve: small, quiet, ordinary cars and anything that belongs at a kerb or on
+// a verge (a post van, a taxi, a tow truck, an off-roader) are allowed longer on the shoulder; loud, low, flashy
+// ones less. It is NOT by tier: every tier has both kinds, and the tiers' averages are kept level. haul: 1 = a
+// van, a pickup or a truck (a load bay: its packages do a little more than its tier's), -1 = a two-seater (less).
+// A car not named here (a new one, a level's vehicle, an idea) has a nerve of 1 and its tier's Delivery
+const CHARACTER = {
+  // one star
+  commuter: [1, 0], junker: [1, 0], darkvan: [0.95, 1], postvan: [1.2, 1], keitruck: [1.15, 1], mini: [1.1, 0], herald: [1, 0],
+  // two
+  lovebus: [1.1, 1], wagon: [1.15, 0], sport: [0.9, -1], lowrider: [0.9, 0], hothatch: [0.95, 0], ute: [1.1, 1], buggy: [1.1, -1], liftedtruck: [1.05, 1], floatvan: [1.05, 1],
+  // three
+  hearse: [1.1, 0], minivan: [1.15, 1], pickup: [1.15, 1], hotrod: [0.8, -1], sleeper: [1.15, 0], rally: [1.1, 0], towtruck: [1.3, 1], rotary: [0.85, -1], toybota: [1.15, 1],
+  // four
+  taxi: [1.2, 0], suv: [1.05, 1], miata: [0.95, -1], dampervan: [1.05, 1], gullwing: [0.9, 0], rearengine: [0.95, 0], snake: [0.85, -1], polytruck: [1, 1],
+  // five
+  muscle: [0.85, 0], fullsize: [1.1, 0], evsaloon: [1.25, 0], superlowrider: [0.85, 0], classicgt: [0.9, -1], sixbysix: [1.15, 1], nissank: [1.1, 1],
+  // the car ideas (ideas.js: placeholders out of the tiers, so a Delivery of 1 whatever the body, until a balancing
+  // pass gives them tiers; their nerve by character like any car's)
+  bubble: [1.2, 0], threewheeler: [1.15, 0], tinsnail: [1.2, 0], twostroke: [1.1, 0], brickestate: [1.15, 0], woody: [1.1, 0], stately: [1, 0], limo: [0.85, 0],
+  milkfloat: [1.3, 0], pony: [0.9, 0], splitwindow: [0.9, 0], wedge: [0.8, 0], centreseat: [0.8, 0], pandacoupe: [0.95, 0], midnight: [0.9, 0], rallywedge: [1.05, 0],
+  safari: [1.15, 0], widetruck: [1.05, 0], monster: [0.85, 0], corrugated: [1.15, 0], foodtruck: [1.2, 0], motorhome: [1.05, 0], schoolbus: [1.1, 0],
+  doubledecker: [0.9, 0], fireengine: [1.25, 0],
+};
+// a tier's Delivery, and a car's (the tier's, and its body's share): to two places
+export const tierDelivery = (tier) => CONFIG.carStats.delivery.base + CONFIG.carStats.delivery.perTier * (tier - 1);
+for (const car of [...CARS, ...EARNED_CARS, ...IDEA_CARS]) {
+  const [nerve, haul] = (!car.earned && CHARACTER[car.id]) || [1, 0], S = CONFIG.carStats; // (an earned car is a prize, not a character: a nerve of 1, its tier's Delivery)
+  if (car.nerve === undefined) car.nerve = nerve;
+  if (car.delivery === undefined) car.delivery = car.tier ? Math.round((tierDelivery(car.tier) + haul * S.delivery.haul) * 100) / 100 : 1;
+}
+// the two stats of any vehicle at all (one out of the garage, a level's, an idea: 1), read here and nowhere else
+export const deliveryOf = (car) => (car && car.delivery) || 1;
+export const nerveOf = (car) => Math.min(CONFIG.carStats.nerve.max, Math.max(CONFIG.carStats.nerve.min, (car && car.nerve) || 1));
