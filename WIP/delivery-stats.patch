diff --git a/scripts/.carstats-check.mjs b/scripts/.carstats-check.mjs
new file mode 100644
index 0000000..5bf291f
--- /dev/null
+++ b/scripts/.carstats-check.mjs
@@ -0,0 +1,111 @@
+// A check of the two car stats that are not about driving, Delivery and Nerve (src/delivery/cars.js,
+// CONFIG.carStats): that each does what it says in a run. (That every car has them, and the rules their values
+// keep, is scripts/.balance-check.mjs.)
+//   node scripts/.carstats-check.mjs
+import { boot } from './delivery-headless.mjs';
+
+const g = await boot({ cars: ['commuter', 'postvan', 'towtruck', 'fullsize', 'hotrod'] });
+const { Packages } = await g.load('packages.js'), { Social } = await g.load('social.js');
+const { CONFIG, Player, Traffic, Game } = g, T = { hi: (s) => g.track.Track.hi(s) }; // (the Track is the level's: made when a run starts)
+let failures = 0;
+const ok = (pass, what) => { if (!pass) failures++; console.log((pass ? '  ok    ' : '  FAIL  ') + what); };
+const near = (a, b, by = 0.02) => Math.abs(a - b) <= by * Math.max(1, Math.abs(b));
+const step = 1 / 60;
+
+// a run in that car, on the first level, as that side; nothing busts or wrecks it
+const start = (car, evil) => {
+  g.select('expressway');
+  g.cars.selectCar(car);
+  Game.evil = evil;
+  Player.testGhost = false;
+  Game.start();
+  g.drive(0, 0);
+  Player.bust = () => {};
+  return g.cars.CAR;
+};
+
+// ---- Nerve: the shoulder's allowance ----
+console.log('Nerve');
+{
+  // s on the shoulder until the meter is empty, in that car
+  const empties = (car) => {
+    start(car, true); // (Evil: no standing to lengthen it)
+    const full = Social.dangerTime;
+    let t = 0;
+    for (; t < 30 && Player.danger > 0; t += step) {
+      Player.lat = T.hi(Player.s) - 0.6; // (kept out on the right shoulder)
+      Game.update(step);
+      g.FxQueue.length = 0;
+    }
+    return { full, t };
+  };
+  const plain = empties('commuter'), post = empties('postvan'), rod = empties('hotrod');
+  ok(near(plain.full, CONFIG.dangerTime), `the Commuter (a nerve of ${g.cars.nerveOf(g.cars.CARS.find(c => c.id === 'commuter'))}) is allowed ${plain.full} s: CONFIG.dangerTime`);
+  ok(near(post.full, CONFIG.dangerTime * 1.2), `the Post Van (1.2) is allowed ${post.full.toFixed(2)} s: 1.2 times as long`);
+  ok(near(rod.full, CONFIG.dangerTime * 0.8), `the Hot Rod (0.8) is allowed ${rod.full.toFixed(2)} s: 0.8 times as long`);
+  ok(near(post.t / plain.t, 1.2, 0.03) && near(rod.t / plain.t, 0.8, 0.03), `out on the shoulder the meter is empty after ${plain.t.toFixed(2)} s in the Commuter, ${post.t.toFixed(2)} s in the Post Van, ${rod.t.toFixed(2)} s in the Hot Rod`);
+  // with full standing (Good) the standing's share multiplies on top; and the cap holds
+  start('towtruck', false);
+  Social.level = 1;
+  const most = CONFIG.dangerTime * 1.3 * (1 + CONFIG.social.danger);
+  ok(near(Social.dangerTime, Math.min(most, CONFIG.carStats.dangerMost)), `the Tow Truck (1.3) in full standing is allowed ${Social.dangerTime.toFixed(2)} s (${most.toFixed(2)} s uncapped, never more than ${CONFIG.carStats.dangerMost} s)`);
+  const was = CONFIG.carStats.dangerMost;
+  CONFIG.carStats.dangerMost = 5;
+  ok(Social.dangerTime === 5, `with the most at 5 s it is allowed ${Social.dangerTime} s: the cap holds`);
+  CONFIG.carStats.dangerMost = was;
+  ok(g.cars.nerveOf({ nerve: 9 }) === CONFIG.carStats.nerve.max && g.cars.nerveOf({ nerve: 0.1 }) === CONFIG.carStats.nerve.min && g.cars.nerveOf({}) === 1 && g.cars.nerveOf(null) === 1,
+    'a nerve is held to its band whatever a car says, and a vehicle with none has 1');
+  // a level that switches the timer off still does (the stat multiplies an allowance: it does not make one)
+  start('hotrod', true);
+  g.levels.LEVEL.shoulderTimer = false;
+  for (let t = 0; t < 6; t += step) { Player.lat = T.hi(Player.s) - 0.6; Game.update(step); g.FxQueue.length = 0; }
+  ok(Player.danger === Social.dangerTime, 'on a level with no shoulder timer the meter stays full, in the Hot Rod too');
+  delete g.levels.LEVEL.shoulderTimer;
+}
+
+// ---- Delivery: what a package does ----
+console.log('Delivery');
+{
+  // one traffic vehicle held just ahead of the player's car, with that much health; packages thrown at it until
+  // it is wrecked (Evil), or one thrown (Good)
+  const held = (health, evil) => {
+    const car = Traffic.cars.find(c => c.active && c.kind !== 'police' && c.dir > 0);
+    Object.assign(car, { evil, maxHealth: health, health, mood: 0 });
+    return car;
+  };
+  const pin = (car) => { Object.assign(car, { s: Player.s + 12, lat: Player.lat, vs: 0, latVel: 0, spin: 0, wobble: 0, active: true, arrest: -1 }); };
+  const wrecks = (id) => {
+    const mine = start(id, true), car = held(320, false);
+    let thrown = 0;
+    for (let t = 0; t < 60 && car.health > 0; t += step) {
+      pin(car);
+      if (Packages.ready && !Packages.list.some(p => p.active)) { Packages.throwOne(); thrown++; }
+      const before = car.health;
+      Packages.update(step);
+      if (car.health < before && car.health > 0) car.spin = car.wobble = 0;
+    }
+    return { thrown, each: CONFIG.evilPackageDamage * g.cars.deliveryOf(mine), delivery: g.cars.deliveryOf(mine) };
+  };
+  const one = wrecks('commuter'), five = wrecks('fullsize');
+  ok(one.delivery === 1 && one.thrown === Math.ceil(320 / CONFIG.evilPackageDamage), `Evil, the Commuter (Delivery 1): ${one.thrown} packages wreck a vehicle of 320 health (${CONFIG.evilPackageDamage} each)`);
+  ok(five.thrown === Math.ceil(320 / five.each) && five.thrown < one.thrown, `Evil, the Full-Size (Delivery ${five.delivery}): ${five.thrown} packages (${five.each.toFixed(1)} each): fewer`);
+  const gift = (id) => {
+    const mine = start(id, false), car = held(320, false);
+    Social.level = 0;
+    for (let t = 0; t < 10 && Social.level === 0; t += step) {
+      pin(car);
+      if (Packages.ready && !Packages.list.some(p => p.active)) Packages.throwOne();
+      Packages.update(step);
+    }
+    return { standing: Social.level, mood: car.mood, health: car.health, delivery: g.cars.deliveryOf(mine) };
+  };
+  const a = gift('commuter'), b = gift('fullsize');
+  ok(near(a.standing, CONFIG.social.gift / 100) && near(a.mood, CONFIG.packageMoodBoost), `Good, the Commuter: a gift wins ${(a.standing * 100).toFixed(1)}% of standing and lifts the driver's mood by ${a.mood}`);
+  ok(near(b.standing, CONFIG.social.gift * b.delivery / 100) && near(b.mood, Math.min(1, CONFIG.packageMoodBoost * b.delivery)), `Good, the Full-Size (Delivery ${b.delivery}): ${(b.standing * 100).toFixed(1)}% and ${b.mood.toFixed(2)}: ${b.delivery} times as much`);
+  ok(a.health === b.health && a.health === 320 - CONFIG.packageDamage, `a Good package scratches the same from either car (${CONFIG.packageDamage})`);
+  ok(g.cars.deliveryOf(g.cars.LEVEL_CARS.ufo) === 1 && g.cars.deliveryOf(null) === 1 && g.cars.deliveryOf({}) === 1, 'a level\'s own vehicle, or one with no stat, has a Delivery of 1');
+}
+
+console.log(failures ? failures + ' FAILED' : 'all checks passed');
+await g.close();
+process.exit(failures ? 1 : 0);
