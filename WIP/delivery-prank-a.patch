+// P4, chattering teeth: the wind-up joke-shop kind, a big set of white teeth on pink gums with a key out of
+// one side, standing in a small open crate (a black face across its opening, the teeth proud of it). The key
+// turning slowly, one clack every couple of seconds / clacking fast, hopping on the spot, the key a blur, the
+// crate rocking / leaping clear of the crate, flipping over to bite its front rim and hang off it, jaws working,
+// then flipping back in to snap on the spot; the crate scooting about; the gums flushed red. On, bouncing, off
+const makeTeeth = () => {
+  const group = new THREE.Group();
+  const slat = lambert(0xb07a3c), slatDark = lambert(0x8a5a2a), gum = lambert(0xf487b2), enamel = lambert(0xfbfbf4), brass = lambert(0xd3a84a);
+  const all = sub(group);
+  const mover = sub(all), crate = sub(mover);
+  const CW = 0.6, CH = 0.3, CD = 0.7, TH = 0.03, FACE = CH - 0.06;
+  part(crate, box(CW, 0.03, CD), slatDark, 0, 0.015, 0);
+  for (const d of [-1, 1]) {
+    part(crate, box(TH, CH, CD), slat, d * (CW / 2 - TH / 2), CH / 2, 0);
+    part(crate, box(CW - 2 * TH, CH, TH), slat, 0, CH / 2, d * (CD / 2 - TH / 2));
+  }
+  for (const y of [0.08, 0.2]) part(crate, box(CW + 0.012, 0.03, CD + 0.012), slatDark, 0, y, 0); // (the bands round it)
+  part(crate, box(CW - 2 * TH - 0.002, 0.004, CD - 2 * TH - 0.002), glow(0x000000), 0, FACE, 0);
+  // the teeth: the lower jaw, with the key and two little feet, and the upper jaw hinged at the back
+  const rig = sub(mover), teeth = sub(rig);
+  const R = 0.17, TB = 0.055, BITE = 0.135;
+  const jawOf = (parent, downward) => {
+    part(parent, torus(R, TB, 20, Math.PI), gum, 0, 0, 0, FLAT);
+    part(parent, box(2 * R + TB, TB * 1.8, 0.1), gum, 0, 0, -0.03);
+    for (let k = 0; k <= 6; k++) {
+      const a = k / 6 * Math.PI, wide = k > 1 && k < 5 ? 0.06 : 0.05, tall = k === 3 || k === 2 || k === 4 ? 0.08 : 0.07;
+      part(parent, box(wide, tall, 0.045), enamel, Math.cos(a) * R, downward ? -TB - tall / 2 + 0.003 : tall / 2 + TB - 0.003, Math.sin(a) * R, 0, FLAT - a);
+    }
+  };
+  const lower = sub(teeth);
+  jawOf(lower, false);
+  part(lower, sphere(0.07, 10, 7), lambert(0xd8304a), 0, 0.075, 0.03).scale.set(1.1, 0.5, 1.3); // (the tongue)
+  part(lower, cyl(0.014, 0.014, 0.1, 8), brass, R + TB + 0.045, 0.03, 0, 0, 0, FLAT);
+  const key = sub(lower, R + TB + 0.1, 0.03, 0);
+  part(key, box(0.012, 0.045, 0.2), brass);
+  for (const z of [-0.1, 0.1]) part(key, cyl(0.045, 0.045, 0.012, 12), brass, 0, 0, z, 0, 0, FLAT);
+  const upperJ = sub(teeth, 0, BITE, -R), upper = sub(upperJ, 0, 0, R);
+  const upGum = sub(upper, 0, 0.075 + TB, 0);
+  jawOf(upGum, true);
+  let keyA = 0;
+  return stated(group, (t, chatter, snap, dt) => {
+    const calm = clamp01(1 - chatter - snap);
+    tint(gum, 0xf487b2, 0xe0304a, snap);
+    keyA += dt * (calm * 1.3 + chatter * 28 + snap * 34);
+    key.rotation.x = keyA;
+    // the crate: still / rocking / scooting about and rocking
+    const rockK = chatter + snap;
+    crate.rotation.z = rockK * Math.sin(t * 9) * 0.06;
+    crate.position.y = rockK * Math.abs(Math.sin(t * 9)) * 0.018;
