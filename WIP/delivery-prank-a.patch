+// P3, a squirting flower: the lapel kind made huge, one big daisy on a stalk, a black rubber bulb on a tube
+// beside it. Nodding in a breeze, the bulb swinging / the bulb squeezing itself, the heart bulging in time,
+// a fat drop forming and falling, the stalk leaning in / a long arc of water out of the heart sweeping side
+// to side as the flower whips about, the petals spinning like a propeller. Still, pulsing, spinning
+const makeSquirter = () => {
+  const group = new THREE.Group();
+  const green = lambert(0x3f9a3a), petalMat = lambert(0xfbfbf4, { side: THREE.DoubleSide }), heartMat = lambert(0xffc927), rubber = lambert(0x1f2226), water = lambert(0x3fa9f5);
+  const all = sub(group);
+  const plant = sub(all); // (it leans and whips from its base)
+  part(plant, cyl(0.03, 0.045, 0.5, 10), green, 0, 0.25, 0);
+  const upper = sub(plant, 0, 0.5, 0);
+  part(upper, cyl(0.026, 0.03, 0.3, 10), green, 0, 0.15, 0);
+  for (const [d, y] of [[1, 0.2], [-1, 0.34]]) { const leaf = part(plant, sphere(0.1, 10, 6), green, d * 0.12, y, 0); leaf.scale.set(1.4, 0.22, 0.6); leaf.rotation.z = d * 0.55; }
+  // the head: a yellow heart in a ring of petals, facing forward and up
+  const head = sub(upper, 0, 0.3, 0);
+  head.rotation.x = -0.55;
+  const heart = part(head, sphere(0.13, 14, 10), heartMat);
+  heart.scale.set(1, 1, 0.55);
+  part(head, sphere(0.09, 10, 7), green, 0, 0, -0.05).scale.z = 0.6;
+  const petals = sub(head, 0, 0, -0.01);
+  for (let k = 0; k < 10; k++) {
+    const a = k / 10 * Math.PI * 2, p = part(petals, sphere(0.1, 10, 6), petalMat, Math.cos(a) * 0.2, Math.sin(a) * 0.2, 0);
+    p.scale.set(0.4, 1.25, 0.18);
+    p.rotation.z = a - FLAT;
+  }
+  // the tube out of the back of the head, down to the bulb, which hangs off its end
+  const curve = new THREE.CatmullRomCurve3([new THREE.Vector3(0, 0.78, -0.08), new THREE.Vector3(0.12, 0.7, -0.09), new THREE.Vector3(0.27, 0.56, -0.03), new THREE.Vector3(0.34, 0.44, 0.02)]);
+  part(plant, new THREE.TubeGeometry(curve, 16, 0.016, 6), rubber);
+  const bulb = sub(plant, 0.34, 0.44, 0.02);
+  part(bulb, cyl(0.02, 0.04, 0.07, 8), rubber, 0, -0.035, 0);
+  const pear = part(bulb, sphere(0.11, 12, 10), rubber, 0, -0.18, 0);
+  pear.scale.set(1, 1.25, 1);
+  // the drop (agitated) and the arc of water into a splash (furious), both from the heart
+  const drop = part(plant, sphere(0.035, 8, 6), water, 0, 0.84, 0.06);
+  const spray = sub(all, 0, 0.8, 0), heartAt = new THREE.Vector3(); // (the arc hangs off the heart wherever the lean puts it, but stays level)
+  const arc = [];
+  for (let u = 0; u <= 0.99; u += 0.03) arc.push(new THREE.Vector3(0, 0.04 + 0.3 * u - 1.15 * u * u, 0.08 + u));
+  part(spray, new THREE.TubeGeometry(new THREE.CatmullRomCurve3(arc), 24, 0.026, 6), water);
+  part(spray, cyl(0.16, 0.16, 0.012, 16), water, 0, -0.794, 1.06);
+  const splashes = [0, 1, 2].map(k => part(spray, sphere(0.03, 6, 5), water, (k - 1) * 0.1, -0.78, 1.06 + (k % 2) * 0.08));
+  let prop = 0;
+  return stated(group, (t, pump, squirt, dt) => {
+    const calm = clamp01(1 - pump - squirt);
+    // a breeze / leaning in / whipping side to side
+    plant.rotation.set(calm * Math.sin(t * 1.3) * 0.04 + pump * 0.18 + squirt * 0.28, 0, squirt * Math.sin(t * 2.4) * 0.22);
+    head.rotation.set(-0.55 + calm * Math.sin(t * 1.7) * 0.07 + squirt * jitter(t, 1) * 0.08, calm * Math.sin(t * 0.9) * 0.1, 0);
+    // the bulb: swinging / squeezing itself flat and round / pumping hard; the heart bulges in time
+    const sq = pump * Math.max(0, Math.sin(t * 4)) + squirt * Math.max(0, Math.sin(t * 11));
+    bulb.rotation.z = calm * Math.sin(t * 1.5) * 0.12;
+    pear.scale.set(1 - sq * 0.38, 1.25 + sq * 0.25, 1 - sq * 0.38);
+    heart.scale.set(1 + sq * 0.15, 1 + sq * 0.15, 0.55 + sq * 0.35);
+    // the drop: forms on the heart, swells, falls
+    const d = (t * 1.1) % 1, grow = d < 0.3 ? d / 0.3 : 1, fall = d < 0.3 ? 0 : ((d - 0.3) / 0.7) ** 2;
+    drop.position.set(0, mix(0.84, 0.03, fall), 0.06 + fall * 0.08);
+    drop.scale.setScalar(Math.max(0.001, pump * grow * (fall > 0.95 ? (1 - fall) * 20 : 1)));
