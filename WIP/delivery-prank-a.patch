diff --git a/src/delivery/render/cargoModelsPrankA.js b/src/delivery/render/cargoModelsPrankA.js
new file mode 100644
index 0000000..f069ece
--- /dev/null
+++ b/src/delivery/render/cargoModelsPrankA.js
@@ -0,0 +1,342 @@
+// ---- the prank cargo, P1 to P4: four more Evil cargo models ------------------------------------------
+// As cargoModelsEvil2.js's (cargoModels.js spreads these into CARGO_MODELS): each a group standing on y = 0,
+// facing +z, about a metre across when calm, with userData.animate(t) and userData.setState(0 | 1 | 2).
+// Plain three.js: nothing here touches the game. The ids are cargo.js's. Each is a joke-shop thing, not a
+// person in a box: calm is the plain thing with one tell, agitated is the prank arming, furious is the prank
+// going off, over and over. Each state is its own outline (IDEAS-prank-cargo-12-Oct.md: three heights of a
+// disc, a bucket upright / rocking / over, a flower still / pulsing / spinning, teeth on / bouncing on / off
+// their crate). An open crate is a flat black face across its opening with the contents standing proud of it.
+import * as THREE from 'three';
+
+const TRANSITION = 0.5; // s from one state to the next: as cargoModels.js's
+
+const lambert = (color, extra) => new THREE.MeshLambertMaterial({ color, ...extra });
+const glow = (color, extra) => new THREE.MeshBasicMaterial({ color, ...extra });
+const haze = (color, opacity = 0.5) => glow(color, { transparent: true, opacity, depthWrite: false });
+const sphere = (r, w = 12, h = 8) => new THREE.SphereGeometry(r, w, h);
+const cyl = (top, bottom, h, n = 14) => new THREE.CylinderGeometry(top, bottom, h, n);
+const cone = (r, h, n = 8) => new THREE.ConeGeometry(r, h, n);
+const torus = (r, t, n = 20, arc = Math.PI * 2) => new THREE.TorusGeometry(r, t, 6, n, arc);
+const box = (w, h, d) => new THREE.BoxGeometry(w, h, d);
+const mix = (a, b, k) => a + (b - a) * k;
+const clamp01 = (v) => Math.max(0, Math.min(1, v));
+const smooth = (u) => { const v = clamp01(u); return v * v * (3 - 2 * v); };
+const FLAT = Math.PI / 2;
+// a part of a model: a mesh at (x, y, z), optionally turned (rx, ry, rz)
+const part = (group, geometry, material, x = 0, y = 0, z = 0, rx = 0, ry = 0, rz = 0) => {
+  const mesh = new THREE.Mesh(geometry, material);
+  mesh.position.set(x, y, z);
+  mesh.rotation.set(rx, ry, rz);
+  group.add(mesh);
+  return mesh;
+};
+const sub = (parent, x = 0, y = 0, z = 0) => { const g = new THREE.Group(); g.position.set(x, y, z); parent.add(g); return g; };
+// shown `k` of the way (0: gone, as near as a scale can be)
+const show = (object, k) => object.scale.setScalar(Math.max(0.001, k));
+// a material's colour, somewhere between two
+const shade = new THREE.Color();
+const tint = (material, from, to, k) => material.color.setHex(from).lerp(shade.setHex(to), clamp01(k));
+// a shake that never repeats in step: -1 .. 1
+const jitter = (t, k = 0) => Math.sin(t * 37.1 + k * 5.3) * Math.sin(t * 23.3 + k * 2.1);
+// things that go round and round a cycle (drops, sheets of water): fn(mesh, 0 .. 1, k)
+const cycle = (list, t, rate, fn) => list.forEach((m, k) => fn(m, (((t * rate + k / list.length) % 1) + 1) % 1, k));
+// a zigzag hanging down from where it starts: a wavy line of air
+const zigzag = (parent, material, n, len, w = 0.022) => {
+  const g = sub(parent);
+  let x = 0, y = 0;
+  for (let k = 0; k < n; k++) {
+    const s = k % 2 ? -1 : 1, dx = s * Math.sin(0.6) * len, dy = -Math.cos(0.6) * len;
+    part(g, box(w, len * 1.1, w), material, x + dx / 2, y + dy / 2, 0, 0, 0, s * 0.6);
+    x += dx; y += dy;
+  }
+  return g;
+};
+// a thin rod of unit length, laid from a to b (both in the rod's parent's frame)
+const UP = new THREE.Vector3(0, 1, 0), X = new THREE.Vector3(1, 0, 0), V = new THREE.Vector3();
+const rod = (parent, material, r = 0.006) => part(parent, new THREE.CylinderGeometry(r, r, 1, 5).translate(0, 0.5, 0), material);
+const lay = (mesh, a, b) => {
+  mesh.position.copy(a);
+  V.subVectors(b, a);
+  mesh.scale.set(1, Math.max(0.001, V.length()), 1);
+  mesh.quaternion.setFromUnitVectors(UP, V.normalize());
+};
+// an Evil item: pose(t, agitated, furious, dt), the two weights 0 .. 1 easing as its state changes
+const stated = (group, pose) => {
+  const w = [1, 0, 0];
+  let target = 0, last = null;
+  group.userData.state = 0;
+  group.userData.setState = (state, snap = false) => {
+    target = Math.max(0, Math.min(2, Math.round(state) || 0));
+    group.userData.state = target;
+    if (snap) for (let i = 0; i < 3; i++) w[i] = i === target ? 1 : 0;
+  };
+  group.userData.animate = (t) => {
+    const dt = last === null ? 0 : Math.min(0.1, Math.abs(t - last));
+    last = t;
+    for (let i = 0; i < 3; i++) w[i] += Math.max(-dt / TRANSITION, Math.min(dt / TRANSITION, (i === target ? 1 : 0) - w[i]));
+    pose(t, w[1], w[2], dt);
+  };
+  group.userData.animate(0);
+  return group;
+};
+
+// P1, a whoopee cushion: a wide plump red disc with a flat nozzle and a yellow star-burst on top, breathing /
+// sagging to two-thirds and refilling in short puffs, the nozzle flapping, rings of air popping off it / going
+// flat as a pancake in one long blast (a fan of wavy air lines), skidding and spinning on the recoil, the star
+// flashing, then refilling fast to do it again. Three heights: plump, sagging, flat
+const makeWhoopee = () => {
+  const group = new THREE.Group();
+  const rubber = lambert(0xd8262b), seam = lambert(0x8e141c), starMat = glow(0xffd23f), air = haze(0xf4faff, 0.9);
+  const all = sub(group);
+  const H = 0.32, R = 0.36, T = H / 2; // the pillow at full height: a cylinder with a rounded edge, and a seam round it
+  const pillow = sub(all);
+  part(pillow, cyl(R, R, H, 28), rubber, 0, T, 0);
+  part(pillow, torus(R, T, 32), rubber, 0, T, 0, FLAT);
+  part(pillow, torus(R + T, 0.012, 32), seam, 0, T, 0, FLAT);
+  // the star-burst printed on top, standing a little proud of it
+  const star = new THREE.Shape();
+  for (let k = 0; k < 16; k++) { const a = k / 16 * Math.PI * 2, r = k % 2 ? 0.11 : 0.26; if (k) star.lineTo(Math.cos(a) * r, Math.sin(a) * r); else star.moveTo(r, 0); }
+  star.closePath();
+  part(pillow, new THREE.ExtrudeGeometry(star, { depth: 0.012, bevelEnabled: false }), starMat, 0, H, 0, -FLAT);
+  // the nozzle: a flat pinched tongue out of the front, with a lip at its tip
+  const nozzle = sub(all, 0, T, R + T - 0.08);
+  const spout = part(nozzle, cone(0.12, 0.34, 4), rubber, 0, 0, 0.17, FLAT);
+  spout.scale.set(1.3, 1, 0.3);
+  const lip = part(nozzle, sphere(0.045, 8, 6), seam, 0, 0, 0.33);
+  lip.scale.set(1.3, 0.45, 0.6);
+  // the air: rings that pop off the tip (agitated), a fan of wavy lines (furious)
+  const rings = [0, 1, 2].map(k => part(nozzle, torus(0.05 + k * 0.045, 0.012, 16), air, 0, 0, 0.4 + k * 0.1));
+  const blast = sub(nozzle, 0, 0, 0.38);
+  const lines = [-2, -1, 0, 1, 2].map(k => {
+    const g = sub(blast);
+    g.rotation.y = k * 0.26;
+    const z = zigzag(g, air, 6, 0.11 + Math.abs(k) * 0.01, 0.03);
+    z.rotation.x = -FLAT; // (hanging down turned to run out along +z)
+    return g;
+  });
+  let spin = 0;
+  return stated(group, (t, wheeze, rip, dt) => {
+    const calm = clamp01(1 - wheeze - rip);
+    // agitated: sagging, refilled in short puffs; furious: one long blast to flat, a pause, a fast refill
+    const p = (t * 1.4) % 1, puff = p < 0.2 ? p / 0.2 : 1 - (p - 0.2) / 0.8;
+    const u = (t * 0.65) % 1, blastK = u < 0.4 ? Math.sin(Math.PI * u / 0.4) : 0;
+    const ripH = u < 0.3 ? mix(1, 0.2, smooth(u / 0.3)) : u < 0.6 ? 0.2 : mix(0.2, 1, smooth((u - 0.6) / 0.4));
+    const h = calm * (1 + Math.sin(t * 1.8) * 0.035) + wheeze * (0.6 + puff * 0.22) + rip * ripH;
+    const sy = Math.max(0.1, h), spread = 1 + (1 - sy) * 0.3;
+    pillow.scale.set(spread * (1 + wheeze * jitter(t, 1) * 0.012), sy, spread * (1 + wheeze * jitter(t, 2) * 0.012));
+    nozzle.position.set(0, T * sy, (R + T) * spread - 0.08);
+    nozzle.rotation.x = -(calm * (0.14 + Math.sin(t * 1.8 + 1) * 0.1) + wheeze * (0.1 + Math.sin(t * 14) * 0.25) + rip * (0.12 + Math.sin(t * 30) * 0.14 * blastK));
+    spout.scale.set(1.3 + rip * blastK * 0.5, 1, 0.3 + rip * blastK * 0.35);
+    const ringK = wheeze * (p < 0.3 ? Math.sin(Math.PI * p / 0.3) : 0);
+    rings.forEach((r, k) => { show(r, ringK); r.position.z = 0.4 + k * 0.1 + ringK * 0.15; });
+    const out = rip * blastK;
+    lines.forEach((g, k) => g.scale.set(Math.max(0.001, out), Math.max(0.001, out), Math.max(0.001, out * (1.2 - Math.abs(k) * 0.12))));
+    tint(starMat, 0xffd23f, 0xffffc0, out);
+    // the recoil: a skid, and a spin that the blast drives
+    spin += dt * rip * blastK * 7;
+    all.rotation.y = spin;
+    all.position.set(rip * blastK * 0.12, 0, 0);
+  });
+};
+
+// P2, a bucket on a trip wire: a brimming galvanised bucket on a wedge, a taut string from its handle down
+// to a peg. Balanced, the string humming / rocking on the wedge, the water tilting against it and sheets of
+// it slopping over the rim / tipped: the bucket on its side rolling about, a sheet of water frozen mid-pour
+// into a pool, drips, the wedge flung clear, the string slack and whipping. Upright, rocking, over
+const makeBucket = () => {
+  const group = new THREE.Group();
+  const zinc = lambert(0xaab3bb, { side: THREE.DoubleSide }), zincDark = lambert(0x6e767e), wood = lambert(0xb07a3c), water = lambert(0x3fa9f5), twine = lambert(0xe8dcc0);
+  const all = sub(group);
+  const RB = 0.22, RT = 0.3, HB = 0.58, LEAN = 0.12;
+  const bucket = sub(all);
+  part(bucket, new THREE.CylinderGeometry(RT, RB, HB, 22, 1, true), zinc, 0, HB / 2, 0);
+  part(bucket, cyl(RB - 0.004, RB - 0.004, 0.02, 20), zincDark, 0, 0.012, 0);
+  part(bucket, torus(RT, 0.02, 26), zincDark, 0, HB, 0, FLAT);
+  part(bucket, torus(RB + 0.012, 0.014, 22), zincDark, 0, 0.05, 0, FLAT);
+  for (const d of [-1, 1]) part(bucket, sphere(0.03, 8, 6), zincDark, d * RT, HB - 0.04, 0);
+  const handle = sub(bucket, 0, HB - 0.04, 0);
+  part(handle, torus(RT, 0.014, 26, Math.PI), zincDark);
+  // the water: a disc below the rim, inside the wall
+  const disc = part(bucket, cyl(RT - 0.035, RT - 0.035, 0.012, 20), water, 0, HB - 0.07, 0);
+  // the wedge under the +x edge (the bucket leans towards the peg), the peg, the string between
+  const shape = new THREE.Shape();
+  shape.moveTo(0, 0); shape.lineTo(0.22, 0); shape.lineTo(0.22, 0.06); shape.closePath();
+  const wedge = part(all, new THREE.ExtrudeGeometry(shape, { depth: 0.28, bevelEnabled: false }).translate(0, 0, -0.14), wood, 0.04, 0, 0);
+  const peg = part(all, cyl(0.018, 0.028, 0.22, 8), wood, -0.78, 0.1, 0.42, 0, 0, -0.18);
+  const pegTop = new THREE.Vector3(-0.76, 0.2, 0.42), tip = new THREE.Vector3(), rim = new THREE.Vector3();
+  const string = rod(all, twine);
+  const loop = part(all, torus(0.15, 0.007, 20, Math.PI * 1.5), twine, -0.62, 0.17, 0.4);
+  // the slop (agitated): sheets over the rim, falling; the pour (furious): a standing sheet into a pool, drips
+  const sheets = [0, 1, 2, 3].map(() => part(all, box(0.16, 0.01, 0.14), water));
+  const pour = sub(all);
+  part(pour, box(0.03, 0.74, 0.3), water, -0.79, 0.33, 0, 0, 0, -0.62);
+  const pool = part(pour, cyl(0.3, 0.3, 0.016, 20), water, -0.9, 0.008, 0);
+  pool.scale.x = 1.3;
+  const drips = [0, 1, 2, 3].map(() => part(pour, sphere(0.024, 6, 5), water));
+  return stated(group, (t, slop, over) => {
+    const calm = clamp01(1 - slop - over), up = clamp01(1 - over);
+    const rock = slop * Math.sin(t * 5.5) * 0.26, roll = over * Math.sin(t * 3) * 0.4;
+    // upright on the wedge, rocking on it / over on its side, rolling, the mouth towards the peg
