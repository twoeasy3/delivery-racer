+    show(spray, squirt);
+    spray.position.copy(heartAt.set(0, 0.8, 0).applyEuler(plant.rotation));
+    spray.rotation.y = Math.sin(t * 2.4) * 0.65;
+    splashes.forEach((s, k) => { s.position.y = -0.78 + Math.abs(Math.sin(t * 9 + k)) * 0.08; });
