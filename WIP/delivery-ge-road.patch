diff --git a/src/delivery/render/sidegrade.js b/src/delivery/render/sidegrade.js
new file mode 100644
index 0000000..54bc1a5
--- /dev/null
+++ b/src/delivery/render/sidegrade.js
@@ -0,0 +1,26 @@
+import { geOn } from '../sidecues.js';
+import { Game } from '../game.js';
+import { Player } from '../player.js';
+
+// idea 6 of IDEAS-good-evil-11-Oct.md (?ge=6): a faint grade at the screen edge, by a change of VALUE (not hue): the edge
+// of the picture is a little darker for Evil, a little brighter for Good. One fixed, click-through div over the canvas,
+// made only with the switch on; syncGrade sets its look when the side changes and its opacity as the run starts or stops.
+const GRADE = {
+  good: 'radial-gradient(ellipse at 50% 50%, rgba(255,250,235,0) 52%, rgba(255,250,235,0.16) 100%)',
+  evil: 'radial-gradient(ellipse at 50% 50%, rgba(25,8,0,0) 42%, rgba(25,8,0,0.40) 100%)',
+};
+let box = null, side = -1, shown = false;
+export const syncGrade = () => {
+  if (!geOn(6)) return;
+  if (!box) {
+    box = document.createElement('div');
+    box.style.cssText = 'position:fixed;inset:0;pointer-events:none;z-index:1;opacity:0;transition:opacity .8s';
+    document.body.appendChild(box);
+  }
+  const on = Game.state === 'playing' && !Game.screensaver && !Game.raceWatch;
+  if (on && side !== (Player.evil ? 1 : 0)) {
+    side = Player.evil ? 1 : 0;
+    box.style.background = side ? GRADE.evil : GRADE.good;
+  }
+  if (on !== shown) { shown = on; box.style.opacity = on ? '1' : '0'; }
+};
diff --git a/src/delivery/sidecues.js b/src/delivery/sidecues.js
new file mode 100644
index 0000000..ab37c54
--- /dev/null
+++ b/src/delivery/sidecues.js
@@ -0,0 +1,13 @@
+// Good/Evil cue switches (12-Oct): ?ge=1,5,8 or ?ge=all turns ideas of IDEAS-good-evil-11-Oct.md on for a visit.
+let set = null;
+export function geOn(n) {
+  if (!set) {
+    set = new Set();
+    try {
+      const v = new URLSearchParams(location.search).get('ge');
+      if (v === 'all') for (let i = 1; i <= 12; i++) set.add(i);
+      else if (v) v.split(',').forEach((x) => { const k = parseInt(x, 10); if (k) set.add(k); });
+    } catch (e) { /* no location: all off */ }
+  }
+  return set.has(n);
+}
