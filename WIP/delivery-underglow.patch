diff --git a/src/delivery/render/sidemarks.js b/src/delivery/render/sidemarks.js
new file mode 100644
index 0000000..cd28581
--- /dev/null
+++ b/src/delivery/render/sidemarks.js
@@ -0,0 +1,85 @@
+// ---- Good/Evil cues on the player's car, on the road (IDEAS-good-evil-11-Oct.md ideas 1 and 2; switches in sidecues.js) ----
+// Flat quads on the car, added to what is underneath like the traffic beams (render/headlights.js). Not lights:
+// no light is added, so three.js rebuilds nothing. Nothing is made unless its switch is on; nothing is allocated per frame.
+import * as THREE from 'three';
+import { carMesh } from './cars.js';
+import { Player } from '../player.js';
+import { geOn } from '../sidecues.js';
+
+const GOOD = 0xcfe6ff, EVIL = 0xff5a1a;
+const texture = (draw) => {
+  const canvas = document.createElement('canvas');
+  canvas.width = canvas.height = 128;
+  draw(canvas.getContext('2d'));
+  return new THREE.CanvasTexture(canvas);
+};
+const quad = (map, y) => {
+  const mat = new THREE.MeshBasicMaterial({ map, transparent: true, opacity: 0, blending: THREE.AdditiveBlending, depthWrite: false,
+    polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -2 });
+  const mesh = new THREE.Mesh(new THREE.PlaneGeometry(1, 1).rotateX(-Math.PI / 2), mat);
+  mesh.position.y = y;
+  mesh.renderOrder = 1;
+  mesh.visible = false;
+  mesh.userData.sideMark = true;
+  carMesh.add(mesh);
+  return mesh;
+};
+
+// idea 2: a pool of light under the body: cool white for Good, an ember for Evil that pulses slowly
+const GLOW = { strength: 0.6, pulse: 0.4, period: 2.4, margin: 1.3 };
+const glow = geOn(2) && quad(texture((g) => {
+  const grad = g.createRadialGradient(64, 64, 0, 64, 64, 64);
+  grad.addColorStop(0, 'rgba(255,255,255,0.85)');
+  grad.addColorStop(0.55, 'rgba(255,255,255,0.75)');
+  grad.addColorStop(1, 'rgba(255,255,255,0)');
+  g.fillStyle = grad;
+  g.fillRect(0, 0, 128, 128);
+}), 0.07);
+let glowSide = null;
+const syncGlow = (now) => {
+  glow.visible = carMesh.visible;
+  if (!glow.visible) return;
+  if (glowSide !== Player.evil) { glowSide = Player.evil; glow.material.color.setHex(glowSide ? EVIL : GOOD); }
+  glow.scale.set(2 * Player.hw + 2 * GLOW.margin, 1, 2 * Player.hl + 2 * GLOW.margin);
+  glow.material.opacity = GLOW.strength * (glowSide ? 1 - GLOW.pulse * (0.5 + 0.5 * Math.sin(now / 1000 * 2 * Math.PI / GLOW.period)) : 1);
+};
+
+// idea 1: a thin line of light laid on the road round the car: a full ring for Good, two short curved arcs (horns) at
+// the front for Evil: the shape differs, not only the colour
+const MARK = { strength: 0.8, margin: 1.0, pulse: 0.25, period: 2.4 };
+const ringTexture = (draw) => texture((g) => {
+  g.lineCap = 'round';
+  g.shadowColor = '#fff';
+  g.shadowBlur = 5;
+  g.strokeStyle = '#fff';
+  g.lineWidth = 7;
+  draw(g);
+});
+const rings = geOn(1) && [
+  ringTexture((g) => { g.beginPath(); g.arc(64, 64, 52, 0, 2 * Math.PI); g.stroke(); }),
+  ringTexture((g) => { // (the quad's front is the bottom of the picture)
+    for (const side of [-1, 1]) {
+      g.beginPath();
+      const mid = Math.PI / 2 + side * 0.8; // (+- 46 degrees off the nose)
+      g.lineWidth = 11;
+      g.arc(64, 64, 54, mid - 0.6, mid + 0.6);
+      g.stroke();
+    }
+  }),
+].map((map) => quad(map, 0.09));
+let ringSide = null;
+const syncRing = (now) => {
+  const evil = Player.evil ? 1 : 0, ring = rings[evil];
+  ring.visible = carMesh.visible;
+  rings[1 - evil].visible = false;
+  if (!ring.visible) return;
+  if (ringSide !== evil) { ringSide = evil; ring.material.color.setHex(evil ? 0xff2a10 : 0xfff0c8); }
+  ring.scale.set(2 * Player.hw + 2 * MARK.margin, 1, 2 * Player.hl + 2 * MARK.margin);
+  ring.material.opacity = MARK.strength * (evil ? 1 - MARK.pulse * (0.5 + 0.5 * Math.sin(now / 1000 * 2 * Math.PI / MARK.period)) : 1);
+};
+
+// every frame, once the car has been put where it is
+export const syncSideMarks = (now) => {
+  if (glow) syncGlow(now);
+  if (rings) syncRing(now);
+};
diff --git a/src/delivery/sidecues.js b/src/delivery/sidecues.js
new file mode 100644
index 0000000..ab37c54
--- /dev/null
+++ b/src/delivery/sidecues.js
@@ -0,0 +1,13 @@
+// Good/Evil cue switches (12-Oct): ?ge=1,5,8 or ?ge=all turns ideas of IDEAS-good-evil-11-Oct.md on for a visit.
+let set = null;
+export function geOn(n) {
+  if (!set) {
+    set = new Set();
+    try {
+      const v = new URLSearchParams(location.search).get('ge');
+      if (v === 'all') for (let i = 1; i <= 12; i++) set.add(i);
+      else if (v) v.split(',').forEach((x) => { const k = parseInt(x, 10); if (k) set.add(k); });
+    } catch (e) { /* no location: all off */ }
+  }
+  return set.has(n);
+}
