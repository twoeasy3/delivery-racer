index 0000000..1f3ad3c
--- /dev/null
+++ b/src/delivery/extras.js
@@ -0,0 +1,24 @@
+// ============================================================================
+// EXTRAS - the gimmicks that came with the themes of 10-Oct (each a level field of its own, usable on any
+// level: see levels.js), gathered here so that Game has one thing to reset and one to update:
+//   toys.js   marbles, loops and paws (the toy room's)
+//   air.js    the car in the air, and low gravity ("lowGravity")
+// Each runs after the player's own update, as Hazards and Gambles do, and puts its hand on the car there.
+// render/extras.js draws them, the same way.
+// ============================================================================
+import { Traffic } from './traffic.js';
+import { Player } from './player.js';
+import { Air } from './air.js';
+import { Toys } from './toys.js';
+
+// (Air last: it has the last word on the car's height off the road)
+const PARTS = [Toys, Air];
+
+export const Extras = {
+  reset() { for (const part of PARTS) part.reset(); },
+  update(dt) {
+    if (Traffic.frozen) return; // (TRAFFIC FREEZE, a mystery: everything here stands still too)
+    Player.aloft = false;       // (over the traffic's heads: said afresh each step by whatever has it up there)
+    for (const part of PARTS) part.update(dt);
+  },
+};
