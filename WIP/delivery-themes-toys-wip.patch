index 0000000..6aa4183
--- /dev/null
+++ b/src/delivery/air.js
@@ -0,0 +1,73 @@
+// ============================================================================
+// AIR - the car off the ground, thrown up by something (a toy loop's kicker, a bump in low gravity) and coming
+// down again under gravity; and how strong gravity is where it is: a level's "lowGravity" stretches (see
+// levels.js), in which it is `g` of the usual (CONFIG.air.lowGravity if not said). In the air there is
+// nothing to push against or brake on (its speed along the road is what it left with), it is over the heads of
+// the traffic and whatever stands on the road (Player.aloft: see Collision), and it comes down where it comes
+// down: on a clear road, or on somebody's roof.
+// Like Hazards and Gambles this runs after the player's own update (Extras.update) and puts its hand on the car
+// there; a drawbridge's jump (hazards.js) is its own affair, and is left alone.
+// ============================================================================
+import { CONFIG } from './config.js';
+import { LEVEL } from './levels.js';
+import { Track } from './track.js';
+import { Player } from './player.js';
+import { Hazards } from './hazards.js';
+import { sfx } from './physics.js';
+import { Game } from './game.js';
+
+export const Air = {
+  on: false,  // in the air (of this file's making)
+  y: 0,       // m above the road
+  vy: 0,      // m/s upwards
+  vx: 0,      // m/s along the road, held while it flies
+  far: 0,     // m flown so far, this jump
+  longest: 0, // the longest jump of the run (m)
+
+  // the share of the usual gravity at s (1: the usual): a level's "lowGravity" stretches, on the expressway
+  scale(s) {
+    if (!LEVEL.lowGravity || !Track.isMain(s)) return 1;
+    const z = LEVEL.lowGravity.find(z => s >= z.from && s <= z.to);
+    return z ? z.g ?? CONFIG.air.lowGravity : 1;
+  },
+  gravity(s) { return CONFIG.air.gravity * this.scale(s); },
+  reset() {
+    this.on = false;
+    this.y = this.vy = this.vx = this.far = this.longest = 0;
+    Player.aloft = false;
+  },
+  // thrown up at vy m/s (never more than CONFIG.air.most): only a car on the ground, on its own wheels
+  launch(vy) {
+    if (this.on || Hazards.jump || !Player.active || !(vy > 0)) return false;
+    this.on = true;
+    this.y = 0;
+    this.vy = Math.min(CONFIG.air.most, vy);
+    this.vx = Player.speed;
+    this.far = 0;
+    return true;
+  },
+  update(dt) {
+    const P = Player, A = CONFIG.air;
+    if (!this.on) return;
+    if (!P.active) { this.reset(); return; }
+    P.s -= (P.speed - this.vx) * dt; // (in the air there is nothing to push against, or brake on)
+    P.speed = this.vx;
+    this.far += this.vx * dt;
+    this.vy -= this.gravity(P.s) * dt;
+    this.y += this.vy * dt;
+    if (this.y <= 0) { // down again
+      const into = -this.vy;
+      this.on = false;
+      this.y = 0;
+      P.aloft = false;
+      P.air = P.pitch = 0;
+      this.longest = Math.max(this.longest, this.far);
+      Game.shake = Math.max(Game.shake, Math.min(1, into / A.shakeAt));
+      sfx('drop', Math.min(1, 0.3 + into / 12));
+      return;
+    }
+    P.air = this.y;
+    P.pitch = Math.atan2(this.vy, Math.max(this.vx, 8)) * A.pitch;
+    P.aloft = this.y > A.clear;
+  },
+};
