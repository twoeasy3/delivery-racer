+    loop: { radius: 7, need: 22, slow: 0.3, advance: 5, kick: 4, launch: 10, fallDamage: 14, fallKeep: 0.3, sign: 120 },
+    paw: { up: 2.8, warn: 1.2, slam: 0.22, down: 1.1, lift: 0.5, notice: 280, hl: 2.3, damage: 32, keep: 0.2, softDamage: 8, softKeep: 0.3, crawl: 7 },
+  },
 
   // photo mode (render/photo.js): the camera starts start.far m from the car, start.yaw round from dead ahead of it
