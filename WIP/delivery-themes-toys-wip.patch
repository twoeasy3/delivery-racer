index 0000000..f9065ea
--- /dev/null
+++ b/src/delivery/toys.js
@@ -0,0 +1,213 @@
+// ============================================================================
+// TOYS - the toy room's gimmicks (see levels.js and CONFIG.toys), each a level field that works on any level:
+//   marbles   glass marbles rolling slowly up the lanes. Run into the back of one and it is shot up the road
+//             like a billiard ball, bowling over whatever traffic it reaches: a knock and some speed for a
+//             cleared lane, or steer round it
+//   loops     a loop of track standing in one lane. Fast enough, the car goes round it and is thrown off the
+//             kicker at its foot, faster and over the heads of the traffic; too slow, it falls off. The lanes
+//             beside it are plain road
+//   paws      a cat asleep beside the road, batting at it: the lanes under its paw are empty and quick for
+//             whoever times the gap, and a flattening for whoever doesn't; the lanes out of its reach are always
+//             safe, and full of everyone else
+// None stops the car and none busts it. What each does is here; render/toys.js draws it. This runs after the
+// player's own update (Extras.update) and puts its hand on the car there.
+// ============================================================================
+import { CONFIG } from './config.js';
+import { LEVEL } from './levels.js';
+import { Track } from './track.js';
+import { Player } from './player.js';
+import { Traffic } from './traffic.js';
+import { Message } from './messages.js';
+import { hurt, sfx, sfxAt } from './physics.js';
+import { Game } from './game.js';
+import { Air } from './air.js';
+
+const clamp01 = (u) => Math.max(0, Math.min(1, u));
+const COLOURS = [0x2f8fff, 0xe23b3b, 0x35a852, 0xf2c21c, 0x9a4fd0, 0xf27d1a];
+
+export const Toys = {
+  marbles: [],  // { s, lat, r, vs, vl (m/s across), on (rolling), turn (rad rolled), color, strikes, s0, lat0 }
+  loops: [],    // { s, lane, lat, need }
+  paws: [],     // { s, side (-1 left, 1 right), lat0, lat1 (what it lands on), t, on, hit }
+  ride: null,   // the player going round a loop: { loop, a (rad round it), v0 (the speed it came in at) }
+  said: {},
+  lastS: 0,
+
+  // the level's lists (as a level loads, for the drawing, and again as each run starts)
+  build() {
+    const C = CONFIG.toys, LW = CONFIG.laneWidth;
+    let seed = 13579;
+    const rand = () => ((seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648);
+    this.marbles = [];
+    for (const z of LEVEL.marbles || []) {
+      const n = z.count || 3;
+      for (let i = 0; i < n; i++) {
+        const s = z.from + (z.to - z.from) * (i + 0.2 + rand() * 0.6) / n;
+        const [first, last] = Track.laneRange(1, s), lane = first + Math.floor(rand() * (last - first + 1));
+        const lat = Track.laneOffset(lane, s);
+        this.marbles.push({ s, lat, s0: s, lat0: lat, r: C.marble.r, vs: 0, vl: 0, on: false, turn: 0, strikes: 0, color: COLOURS[this.marbles.length % COLOURS.length] });
+      }
+    }
+    this.loops = (LEVEL.loops || []).map(l => ({ s: l.s, lane: l.lane, lat: Track.laneOffset(l.lane, l.s) }));
+    this.paws = (LEVEL.paws || []).map((p) => {
+      const side = p.side === 'left' ? -1 : 1, [a, b] = p.lanes || Track.laneRange(1, p.s);
+      return { s: p.s, side, lat0: Track.laneOffset(a, p.s) - LW / 2, lat1: Track.laneOffset(b, p.s) + LW / 2, t: 0, on: false, hit: false };
+    });
+  },
+  reset() {
+    this.build();
+    this.ride = null;
+    this.said = {};
+    this.lastS = Player.s;
+  },
+  once(key) {
+    if (this.said[key]) return;
+    this.said[key] = true;
+    Message.say('events', key);
+  },
+
+  // ---- what each is doing, for the drawing (and the rules below) -------------------------------------
+  // the speed a loop asks for, where it stands (m/s): less in low gravity
+  loopNeed(l) { return CONFIG.toys.loop.need * Math.sqrt(Air.scale(l.s)); },
+  // how high a paw is, 1 (right up) .. 0 (lying on the road); and how much of its shadow shows, 0 .. 1
+  pawUp(p) {
+    const C = CONFIG.toys.paw;
+    if (!p.on) return 1;
+    const u = p.t % (C.up + C.slam + C.down + C.lift);
+    return u < C.up ? 1 : u < C.up + C.slam ? 1 - (u - C.up) / C.slam : u < C.up + C.slam + C.down ? 0 : (u - C.up - C.slam - C.down) / C.lift;
+  },
+  pawWarn(p) {
+    const C = CONFIG.toys.paw, u = p.t % (C.up + C.slam + C.down + C.lift);
+    return !p.on ? 0 : u < C.up ? clamp01((u - (C.up - C.warn)) / C.warn) : u < C.up + C.slam + C.down ? 1 : 0;
+  },
+  // is (s, lat), hl x hw either way, under a paw's pad?
+  underPaw(p, v) {
+    return Math.abs(v.s - p.s) < CONFIG.toys.paw.hl + v.hl && v.lat + v.hw > p.lat0 && v.lat - v.hw < p.lat1;
+  },
+
+  updateMarbles(dt, live) {
+    const M = CONFIG.toys.marble, P = Player;
+    for (const m of this.marbles) {
+      if (m.gone) continue;
+      if (!m.on && P.active && m.s - P.s < M.trigger && m.s - P.s > -30) m.on = true;
+      if (!m.on) continue;
+      m.vs = m.vs > M.roll ? Math.max(M.roll, m.vs - M.drag * dt) : M.roll;
+      m.vl *= Math.max(0, 1 - 0.5 * dt);
+      m.s += m.vs * dt;
+      m.lat += m.vl * dt;
+      m.turn += m.vs * dt / m.r;
+      const lo = Track.lo(m.s) + m.r, hi = Track.hi(m.s) - m.r;
+      if (m.lat < lo || m.lat > hi) { m.lat = m.lat < lo ? lo : hi; m.vl = -m.vl * M.bounce; } // (back off the track's lip)
+      if (m.s > Track.length + 60 || P.s - m.s > 150) { m.gone = true; continue; }
+      // bowling: whatever it is closing on fast enough goes over
+      if (m.vs > M.roll + M.bowl) {
+        for (const car of Traffic.cars) {
+          if (!car.active || car.junction || car.health <= 0 || Math.abs(car.s - m.s) > car.hl + m.r || Math.abs(car.lat - m.lat) > car.hw + m.r * 0.8) continue;
+          if (m.vs - car.vs * car.dir < M.bowl) continue;
+          car.health = 0; // (it blows up: Collision.check)
+          m.vs *= M.through;
+          m.strikes++;
+          sfxAt('crash', m.s, 0.7);
+          this.once('marbleStrike');
+        }
+      }
+      // the player's car: into the back of it, a shot; alongside, it is only nudged away
+      if (!live || P.aloft || Math.abs(P.s - m.s) > P.hl + m.r || Math.abs(P.lat - m.lat) > P.hw + m.r * 0.85) continue;
+      const off = (m.lat - P.lat) / (P.hw + m.r);
+      if (P.s < m.s && P.speed - m.vs > 1) {
+        m.vs = Math.max(M.shotMin, P.speed * M.shot);
+        m.vl = off * M.glance;
+        m.s = P.s + P.hl + m.r + 0.3;
+        if (P.tank <= 0) { P.speed *= M.keep; hurt(P, M.damage); }
+        Game.shake = Math.max(Game.shake, 0.5);
+        sfx('drop', 0.9);
+        this.once('marble');
+      } else m.vl = Math.sign(off || 1) * 4;
+    }
+  },
+
+  updateLoops(dt, from) {
+    const L = CONFIG.toys.loop, P = Player, R = L.radius;
+    if (this.ride) { // round it: up the far side, over the top upside down, and down again to where it came in
+      const r = this.ride;
+      if (!P.active) { this.ride = null; return; }
+      const v = r.v0 * (1 - L.slow * (1 - Math.cos(r.a)) / 2);
+      r.a += v / R * dt;
+      P.lat += (r.loop.lat - P.lat) * Math.min(1, 8 * dt);
+      P.latVel = 0;
+      if (r.a >= Math.PI * 2) { // down, and off the kicker at its foot
+        this.ride = null;
+        P.s = r.loop.s + L.advance;
+        P.air = P.pitch = 0;
+        P.speed = r.v0 + L.kick;
+        Air.launch(L.launch);
+        this.once('loopDone');
+        return;
+      }
+      P.s = r.loop.s + R * Math.sin(r.a) + L.advance * r.a / (Math.PI * 2);
+      P.speed = v;
+      P.air = R * (1 - Math.cos(r.a));
+      P.pitch = r.a;
+      P.aloft = P.air > CONFIG.air.clear;
+      return;
+    }
+    if (!P.active || Air.on || P.tank > 0) return;
+    for (const l of this.loops) {
+      if (l.s - P.s > 0 && l.s - P.s < L.sign + 80) this.once('loop');
+      if (!(from < l.s && P.s >= l.s && P.s - from < 30) || Math.abs(P.lat - l.lat) > CONFIG.laneWidth / 2) continue;
+      if (P.speed >= this.loopNeed(l)) {
+        this.ride = { loop: l, a: 0, v0: P.speed };
+        sfx('turbo', 0.6);
+      } else { // too slow: part of the way up, and off
+        if (P.shield <= 0 && P.ghost <= 0) hurt(P, L.fallDamage);
+        P.speed *= L.fallKeep;
+        P.stun = Math.max(P.stun, CONFIG.stunTime * 0.5);
+        Game.shake = 1;
+        sfx('crash', 0.8);
+        Air.launch(4);
+        this.once('loopSlow');
+      }
+    }
+  },
+
+  updatePaws(dt, live) {
+    const C = CONFIG.toys.paw, P = Player, period = C.up + C.slam + C.down + C.lift;
+    for (const p of this.paws) {
+      const ahead = p.s - P.s, near = P.active && ahead < C.notice && ahead > -60;
+      // (it starts with its paw up, and stops with it up: nothing happens where nobody is looking)
+      if (!p.on) { if (near) { p.on = true; p.t = 0; p.hit = false; this.once('paw'); } else continue; }
+      const before = p.t % period;
+      p.t += dt;
+      const u = p.t % period;
+      if (!near && u < C.up && before > u) { p.on = false; continue; }
+      const landed = before < C.up + C.slam && u >= C.up + C.slam, down = u >= C.up + C.slam && u < C.up + C.slam + C.down;
+      if (u < before) p.hit = false;
+      if (landed) {
+        if (Math.abs(ahead) < 300) sfxAt('drop', p.s, 1);
+        for (const car of Traffic.cars) if (car.active && !car.junction && car.health > 0 && this.underPaw(p, car)) car.health = 0;
+        if (Math.abs(ahead) < 40) Game.shake = Math.max(Game.shake, 0.6);
+      }
+      if (down) for (const car of Traffic.cars) if (car.active && !car.junction && car.health > 0 && this.underPaw(p, car)) car.health = 0;
+      if (!live || P.aloft || P.tank > 0 || !(landed || down) || !this.underPaw(p, P)) continue;
+      if (p.hit) { P.speed = Math.min(P.speed, C.crawl); continue; } // (under it still: it crawls out from under, never held)
+      p.hit = true;
+      const flat = landed || P.s > p.s - C.hl; // (under it as it came down; or only run into where it lies)
+      hurt(P, flat ? C.damage : C.softDamage);
+      P.speed *= flat ? C.keep : C.softKeep;
+      P.stun = Math.max(P.stun, CONFIG.stunTime * (flat ? 1 : 0.4));
+      Game.shake = 1;
+      sfx('crash', 1);
+      this.once('pawHit');
+    }
+  },
+
+  update(dt) {
+    const from = this.lastS;
+    this.lastS = Player.s;
+    const live = Player.active && Player.shield <= 0 && Player.ghost <= 0;
+    if (this.marbles.length) this.updateMarbles(dt, live);
+    if (this.loops.length) this.updateLoops(dt, from);
+    if (this.paws.length) this.updatePaws(dt, live);
+    if (this.ride) this.lastS = Player.s;
+  },
+};
