index 0000000..a77c288
--- /dev/null
+++ b/scripts/.themes-check.mjs
@@ -0,0 +1,148 @@
+// A check of the gimmicks that came with the themes of 10-Oct (src/delivery/extras.js: toys.js, air.js, ...), one
+// at a time, headless: for each, both sides of its gamble (the risky line pays when it is driven right and costs
+// when it is not), that the safe line always works, and that nothing forces a stop.
+//   node scripts/.themes-check.mjs [name ...]     (names: only those sections: marbles loops paws gravity ...)
+import { boot } from './delivery-headless.mjs';
+
+const ONLY = process.argv.slice(2);
+const g = await boot({ cars: ['commuter', 'sport', 'darkvan', 'floatvan', 'toybota', 'semi'] });
+let failures = 0;
+const check = (ok, what) => { if (!ok) failures++; console.log((ok ? '  ok    ' : '  FAIL  ') + what); };
+const section = async (name, run) => { if (!ONLY.length || ONLY.includes(name)) { console.log('---- ' + name); await run(); } };
+try {
+  const { Toys } = await g.load('toys.js');
+  const { Air } = await g.load('air.js');
+  const { Hazards } = await g.load('hazards.js');
+  const { Progress } = await g.load('progress.js');
+  const P = g.Player, G = g.Game, C = g.CONFIG;
+  const T = () => g.track.Track;
+  const lane = (n, s) => T().laneOffset(n, s);
+  const quiet = () => { for (const car of g.Traffic.cars) if (!car.fixed) car.active = false; };
+  const said = (text) => g.said.some(line => line.includes(text));
+  // a fresh run in `car` on the level picked, set down at s in lane n doing v, no traffic in the way
+  const start = (s, n, v, { car = 'sport', ghost = false } = {}) => {
+    Progress.data.car = car;
+    P.testGhost = false;
+    G.evil = false;
+    g.said.length = 0;
+    G.start();
+    quiet();
+    Object.assign(P, { s, lat: lane(n, s), speed: v, launching: false, shield: 0 });
+    Hazards.lastS = Toys.lastS = s;
+    P.testGhost = ghost;
+    g.drive(1, 0);
+  };
+  // a traffic vehicle of a kind put at (s, lat) doing v the player's way, for a check
+  const put = (kind, s, lat, v) => {
+    const car = g.Traffic.cars.find(c => !c.active && c.dir > 0);
+    const type = C.vehicles[kind];
+    Object.assign(car, { active: true, fixed: true, kind, s, lat, lane: T().nearestLane(lat, s), vs: v, baseSpeed: v, hw: type.hw, hl: type.hl, height: type.height, mass: type.mass,
+      health: type.health, maxHealth: type.health, latVel: 0, yaw: 0, spin: 0, stun: 0, junction: null, parked: false, viaSide: false, evil: false });
+    return car;
+  };
+  // a level made for a check: a straight, level road with what is asked on it
+  const road = (extra, length = 2400) => g.select({ id: 'check', name: 'Check', clock: { good: 300, evil: 300 }, tip: 1, lanes: { north: 3, south: 2 }, traffic: { commuter: 1 }, trafficCount: 6, oncomingCount: 0,
+    segments: [{ length, curve: 0 }], ...extra });
+  const problems = () => T().problems.join(' | ') || 'none';
+
+  await section('marbles', () => {
+    const M = C.toys.marble;
+    road({ marbles: [{ from: 400, to: 401, count: 1 }] });
+    start(300, 3, 28);
+    check(!T().problems.length && Toys.marbles.length === 1, 'marbles: the level loads (' + problems() + '), with its marble');
+    // into the back of it, a van 150 m further up the same lane
+    const m = Toys.marbles[0];
+    Object.assign(P, { s: m.s - 60, lat: m.lat, speed: 28 });
+    Toys.lastS = P.s;
+    const van = put('darkvan', m.s + 150, m.lat, 12), health = P.health;
+    let shot = 0, slowest = Infinity, stopped = false;
+    g.run(12, () => { shot = Math.max(shot, m.vs); slowest = Math.min(slowest, P.speed); if (P.speed < 1) stopped = true; return van.health <= 0 || !van.active; });
+    check(shot >= M.shotMin, 'marbles, the risky line: run into from behind, the marble is shot up the road (' + shot.toFixed(0) + ' m/s)');
+    check(P.health < health && P.health > health - 12 && slowest > 15 && !stopped, 'marbles, its cost: a knock (' + (health - P.health).toFixed(0) + ' health) and some speed (down to ' + slowest.toFixed(0) + ' m/s), never a stop');
+    check(van.health <= 0 || !van.active, 'marbles, its pay: the van up the lane is bowled over (' + m.strikes + ' strike)');
+    check(said('shot the marble') && said('Strike'), 'marbles: it is said');
+    // round it: nothing happens
+    start(300, 3, 28);
+    const m2 = Toys.marbles[0], other = [2, 3, 4].find(n => Math.abs(lane(n, m2.s) - m2.lat) > 2);
+    Object.assign(P, { s: m2.s - 60, lat: lane(other, m2.s), speed: 28 });
+    Toys.lastS = P.s;
+    const h2 = P.health;
+    let most = 0;
+    g.run(6, () => { most = Math.max(most, m2.vs); return P.s > m2.s + 60; });
+    check(P.health === h2 && most <= M.roll + 0.01, 'marbles, the safe line: in the next lane the car passes untouched and the marble rolls on');
+  });
+
+  await section('loops', () => {
+    const L = C.toys.loop;
+    road({ loops: [{ s: 600, lane: 4 }], obstacles: [{ s: 612, lane: 4, kind: 'barrier' }, { s: 622, lane: 4, kind: 'barrier' }] });
+    start(480, 4, 30);
+    check(!T().problems.length && Toys.loops.length === 1, 'loops: the level loads (' + problems() + ')');
+    const need = Toys.loopNeed(Toys.loops[0]);
+    let top = 0, back = 0, upside = false, health = P.health, v0 = 0, after = 0, flew = 0, stopped = false;
+    g.run(12, () => {
+      if (Toys.ride) { top = Math.max(top, P.air); if (!v0) v0 = Toys.ride.v0; if (Math.cos(P.pitch) < -0.9) upside = true; back = Math.max(back, 600 + L.radius - P.s); }
+      if (Air.on) flew = Math.max(flew, P.air);
+      if (P.speed < 1) stopped = true;
+      if (P.s > 640 && !Air.on && !after) after = P.speed;
+      return P.s > 700;
+    });
+    check(top > L.radius * 1.9 && upside, 'loops, the risky line: at ' + v0.toFixed(0) + ' m/s (it asks ' + need.toFixed(0) + ') the car goes round, ' + top.toFixed(1) + ' m up and upside down at the top');
+    check(P.health === health && flew > C.air.clear && Air.longest > 15, 'loops, its pay: off the kicker it jumps ' + Air.longest.toFixed(0) + ' m, clean over the two barriers in its lane');
+    check(after > v0 && !stopped, 'loops, its pay: it comes out faster (' + v0.toFixed(0) + ' to ' + after.toFixed(0) + ' m/s), never stopped');
+    check(said('Loop ahead') && said('Looped the loop'), 'loops: it is said');
+    // too slow
+    start(540, 4, need - 6);
+    g.drive(0, 0);
+    const h1 = P.health;
+    let rode = false, least = Infinity;
+    g.run(4, () => { P.speed = Math.min(P.speed, need - 6); if (Toys.ride) rode = true; least = Math.min(least, P.speed); return P.s > 606; });
+    check(!rode && P.health < h1 && said('Too slow'), 'loops, its cost: at ' + (need - 6).toFixed(0) + ' m/s the car falls off (' + (h1 - P.health).toFixed(0) + ' health, down to ' + least.toFixed(0) + ' m/s)');
+    // the next lane: plain road
+    start(480, 3, 30);
+    const h2 = P.health;
+    let rode2 = false;
+    g.run(6, () => { if (Toys.ride || Air.on) rode2 = true; return P.s > 700; });
+    check(!rode2 && P.health === h2, 'loops, the safe line: the lane beside it is plain road');
+    // a loop not on straight, level road in the player's lanes is reported
+    road({ loops: [{ s: 600, lane: 1 }] });
+    start(100, 3, 20);
+    check(T().problems.some(p => p.includes('loop at 600')), 'loops: one in an oncoming lane is reported (' + problems() + ')');
+  });
+
+  await section('paws', () => {
+    const W = C.toys.paw, period = W.up + W.slam + W.down + W.lift;
+    road({ paws: [{ s: 800, side: 'right', lanes: [3, 4] }] });
+    // under it as it lands: the car is set down so as to be at the paw just as it comes down
+    const pass = (n, v, lead) => {
+      start(800 - v * lead, n, v);
+      const p = Toys.paws[0];
+      p.on = true; p.t = 0;
+      const health = P.health;
+      let least = Infinity;
+      g.run(lead + 3, () => { P.speed = Math.max(P.speed, 0); least = Math.min(least, P.speed); return P.s > 860; });
+      return { lost: health - P.health, least, t: G.time };
+    };
+    const flat = pass(4, 30, W.up + W.slam);
+    check(!T().problems.length, 'paws: the level loads (' + problems() + ')');
+    check(flat.lost >= W.damage * 0.9 && said('Swatted'), 'paws, the cost: under it as it lands, ' + flat.lost.toFixed(0) + ' health and down to ' + flat.least.toFixed(0) + ' m/s');
+    check(flat.least > 0.5, 'paws: even flattened, the car is never held (slowest ' + flat.least.toFixed(1) + ' m/s)');
+    const clean = pass(4, 30, W.up * 0.5);
+    check(clean.lost === 0 && clean.least >= 29, 'paws, the risky line driven right: under it while it is up, untouched');
+    const safe = pass(2, 30, W.up + W.slam);
+    check(safe.lost === 0, 'paws, the safe line: the lane out of its reach, as it lands: untouched');
+    // traffic under it is flattened
+    start(600, 2, 20);
+    const p = Toys.paws[0], van = put('darkvan', 800, lane(4, 800), 0);
+    p.on = true; p.t = W.up - 0.1;
+    g.run(1.5, () => { van.s = 800; van.vs = 0; return van.health <= 0; });
+    check(van.health <= 0 || !van.active, 'paws: a van under it as it lands is flattened too');
+    check(Math.abs(period - 4.62) < 2, 'paws: it bats every ' + period.toFixed(1) + ' s, up for ' + W.up + ' of them');
+    road({ paws: [{ s: 800, side: 'right', lanes: [2, 4] }] });
+    start(100, 3, 20);
+    check(T().problems.some(q => q.includes('paw at 800')), 'paws: one that leaves no lane out of its reach is reported');
+  });
+} finally {
+  await g.close();
+}
+console.log(failures ? failures + ' FAILED' : 'all checks passed');
+process.exit(failures ? 1 : 0);
