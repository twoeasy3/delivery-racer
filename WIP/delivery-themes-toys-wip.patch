diff --git a/src/delivery/render/toys.js b/src/delivery/render/toys.js
new file mode 100644
index 0000000..57def3a
--- /dev/null
+++ b/src/delivery/render/toys.js
@@ -0,0 +1,101 @@
+// ---- TOYS: the toy room's gimmicks, drawn (what they do: ../toys.js) ----
+// Marbles: glass, a twist of colour inside, turning as they roll. A loop: a ring of orange track standing in its
+// lane on blue stands, a yellow run-up painted into it and a board before it with the speed it asks. A paw: a
+// cat asleep beside the road, one foreleg lifting and coming down across the lanes, its shadow on the road
+// first.
+import * as THREE from 'three';
+import { CONFIG } from '../config.js';
+import { Track } from '../track.js';
+import { Game } from '../game.js';
+import { Toys } from '../toys.js';
+import { scene, tmp } from './scene.js';
+import { buildStrip } from './road.js';
+import { makeMarble, makeLoop, makeCat, makePaw } from './themes/toyModels.js';
+
+const group = new THREE.Group();
+scene.add(group);
+const lambert = (color) => new THREE.MeshLambertMaterial({ color });
+const paint = (color, opacity) => new THREE.MeshBasicMaterial({ color, transparent: true, opacity, depthWrite: false, side: THREE.DoubleSide, polygonOffset: true, polygonOffsetFactor: -3, polygonOffsetUnits: -3 });
+// a group set down on the road at (s, lat), facing along it (its local +z the player's way, +x to the left)
+const at = (s, lat, y = 0) => {
+  const g = new THREE.Group();
+  g.rotation.y = Track.toWorld(s, lat, tmp);
+  g.position.set(tmp.x, tmp.y + y, tmp.z);
+  group.add(g);
+  return g;
+};
+// words on a board (a canvas texture)
+export const board = (text, bg, fg, w, h) => {
+  const canvas = document.createElement('canvas');
+  canvas.width = 512;
+  canvas.height = Math.round(512 * h / w);
+  const c = canvas.getContext('2d');
+  c.fillStyle = bg;
+  c.fillRect(0, 0, canvas.width, canvas.height);
+  c.fillStyle = fg;
+  c.font = `bold ${Math.round(canvas.height * 0.55)}px system-ui, sans-serif`;
+  c.textAlign = 'center';
+  c.textBaseline = 'middle';
+  c.fillText(text, canvas.width / 2, canvas.height / 2 + 2);
+  return new THREE.Mesh(new THREE.PlaneGeometry(w, h), new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(canvas), side: THREE.DoubleSide }));
+};
+
+let marbles = [], paws = [];
+
+Game.onLoad.push(() => {
+  group.traverse((o) => { if (o.geometry) o.geometry.dispose(); if (o.material?.map) o.material.map.dispose(); });
+  group.clear();
+  Toys.build(); // (its lists, for the level just loaded)
+  const LW = CONFIG.laneWidth, L = CONFIG.toys.loop, P = CONFIG.toys.paw;
+  marbles = Toys.marbles.map((m) => { const model = makeMarble(m.color, m.r); group.add(model); return model; });
+  for (const l of Toys.loops) {
+    at(l.s, l.lat).add(makeLoop(L.radius, LW - 0.4));
+    group.add(new THREE.Mesh(buildStrip(l.s - 45, l.s, (s) => Track.laneOffset(l.lane, s) - LW / 2 + 0.35, (s) => Track.laneOffset(l.lane, s) + LW / 2 - 0.35, 0.03, 3), paint(0xffe12b, 0.55)));
+    const kicker = new THREE.Mesh(new THREE.BoxGeometry(LW - 0.4, 0.5, 3), lambert(0x1f6fd0)); // (the kicker at its foot)
+    kicker.rotation.x = -0.16;
+    kicker.position.set(0, 0.2, L.advance - 1.5);
+    at(l.s, l.lat).add(kicker);
+    for (const side of [-1, 1]) { // a board each side of the road, well before it: the speed it asks
+      const s = Math.max(5, l.s - L.sign), post = at(s, side < 0 ? Track.lo(s) + 0.5 : Track.hi(s) - 0.5);
+      const pole = new THREE.Mesh(new THREE.BoxGeometry(0.16, 3.2, 0.16), lambert(0x8a9096));
+      pole.position.y = 1.6;
+      const sign = board('LOOP ' + Math.round(Toys.loopNeed(l) * 3.6) + '+', '#1f6fd0', '#fff', 3.4, 1.1);
+      sign.position.y = 3.6;
+      sign.rotation.y = Math.PI;
+      post.add(pole, sign);
+    }
+  }
+  paws = Toys.paws.map((p) => {
+    const edge = p.side > 0 ? Track.hi(p.s) : Track.lo(p.s), pivot = edge + p.side * 3;
+    const far = p.side > 0 ? p.lat0 : p.lat1, reach = Math.abs(pivot - far);
+    const cat = makeCat(), spot = at(p.s - 13, pivot + p.side * 9);
+    spot.add(cat);
+    const arm = at(p.s, pivot, 1.9), leg = makePaw(reach);
+    if (p.side < 0) arm.rotation.y += Math.PI; // (its local +x: towards the road)
+    arm.add(leg);
+    const shadow = new THREE.Mesh(buildStrip(p.s - P.hl, p.s + P.hl, p.lat0, p.lat1, 0.04, 2), paint(0x101018, 0));
+    group.add(shadow);
+    return { cat, leg, shadow };
+  });
+});
+
+export const syncToys = (now) => {
+  const t = now / 1000;
+  Toys.marbles.forEach((m, i) => {
+    const model = marbles[i];
+    if (!model) return;
+    model.visible = !m.gone;
+    if (m.gone) return;
+    model.rotation.y = Track.toWorld(m.s, m.lat, tmp);
+    model.position.copy(tmp);
+    model.userData.spin.rotation.x = m.turn;
+  });
+  Toys.paws.forEach((p, i) => {
+    const view = paws[i];
+    if (!view) return;
+    const up = Toys.pawUp(p);
+    view.leg.rotation.z = up * 0.95 + (p.on ? 0 : Math.sin(t * 0.8) * 0.04); // (asleep, with nobody near: only a twitch)
+    view.shadow.material.opacity = Toys.pawWarn(p) * 0.5;
+    view.cat.userData.animate(t);
+  });
+};
