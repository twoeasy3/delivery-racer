--- /dev/null
+++ b/src/delivery/extrasCheck.js
@@ -0,0 +1,42 @@
+// ============================================================================
+// The level fields that came with the themes of 10-Oct (see levels.js), checked as a level loads: called from
+// Track's own check with what it knows of the road. Each problem is a line for the HUD, as Track's are.
+//   road: { length, lanes (how many the expressway has), playerLanes(s): [first, last] going the player's way,
+//           straight(from, to), level(from, to), waters, tunnels, problems: [] }
+// ============================================================================
+import { CONFIG } from './config.js';
+
+export const checkExtras = (level, road) => {
+  const { length, problems } = road;
+  const main = (z) => z.from < z.to && z.from >= 0 && z.to <= length && z.road !== 'side';
+  const onMain = (item, s = item.s) => item.road !== 'side' && s >= 20 && s <= length - 20;
+  const ours = (lane, s) => { const [a, b] = road.playerLanes(s); return Number.isInteger(lane) && lane >= a && lane <= b; };
+  // ---- the toy room's (toys.js)
+  for (const z of level.marbles || []) {
+    if (!main(z)) problems.push('marbles at ' + z.from + ': from before to, on the expressway');
+    else if (z.count !== undefined && !(z.count >= 1 && z.count <= 40)) problems.push('marbles at ' + z.from + ': count is 1 to 40');
+  }
+  for (const l of level.loops || []) {
+    const R = CONFIG.toys.loop.radius + 10;
+    if (!onMain(l, l.s - R) || !onMain(l, l.s + R)) problems.push('loop at ' + l.s + ': on the expressway, clear of its ends');
+    else if (!ours(l.lane, l.s)) problems.push('loop at ' + l.s + ': in a lane going the player\'s way');
+    else if (!road.straight(l.s - R, l.s + R + 40)) problems.push('loop at ' + l.s + ': the road must run straight through it and on for the landing');
+    else if (!road.level(l.s - R, l.s + R + 40)) problems.push('loop at ' + l.s + ': on level road');
+    else if (road.tunnels.some(t => l.s > t.from - 30 && l.s < t.to + 30)) problems.push('loop at ' + l.s + ': not in a tunnel (it stands ' + CONFIG.toys.loop.radius * 2 + ' m tall)');
+  }
+  for (const p of level.paws || []) {
+    if (!onMain(p)) problems.push('paw at ' + p.s + ': on the expressway, clear of its ends');
+    else if (p.side !== 'left' && p.side !== 'right') problems.push('paw at ' + p.s + ': side is left or right (where the cat lies)');
+    else if (p.lanes !== undefined && !(Array.isArray(p.lanes) && p.lanes.length === 2 && p.lanes[0] <= p.lanes[1] && p.lanes[0] >= 0 && p.lanes[1] < road.lanes)) problems.push('paw at ' + p.s + ': lanes is [first, last], lanes of the road');
+    else {
+      const [a, b] = road.playerLanes(p.s), [f, l] = p.lanes || [a, b];
+      if (f <= a && l >= b && a === b) problems.push('paw at ' + p.s + ': it must leave the player a lane out of its reach (a road with one lane each way has none)');
+      else if (f <= a && l >= b) problems.push('paw at ' + p.s + ': lanes must leave a lane of the player\'s side out of its reach');
+    }
+  }
+  // ---- low gravity (air.js)
+  for (const z of level.lowGravity || []) {
+    if (!main(z)) problems.push('low gravity at ' + z.from + ': from before to, on the expressway');
+    else if (z.g !== undefined && !(z.g >= 0.1 && z.g <= 1)) problems.push('low gravity at ' + z.from + ': g is 0.1 to 1 (the share of the usual gravity)');
+  }
+};
