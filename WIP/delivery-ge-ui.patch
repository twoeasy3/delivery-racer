diff --git a/src/delivery/render/sideglyph.js b/src/delivery/render/sideglyph.js
new file mode 100644
index 0000000..0eecb62
--- /dev/null
+++ b/src/delivery/render/sideglyph.js
@@ -0,0 +1,14 @@
+// The Good / Evil badge shapes (the halo and the horns of sides.js), as small SVG for the in-game and menu cues of
+// IDEAS-good-evil-11-Oct.md (8: the cargo corner, 10: the menu and garage). Shape carries the side, not hue: each has a dark outline
+// so it reads on any ground, and the two differ in outline (a flat ring, a pair of points).
+const HALO = '<ellipse cx="12" cy="12" rx="9" ry="4.2" fill="none" stroke="#000" stroke-opacity=".55" stroke-width="5"/><ellipse cx="12" cy="12" rx="9" ry="4.2" fill="none" stroke="#ffd23f" stroke-width="3"/>';
+const HORNS = '<path d="M3 21 Q2 9 8 3 Q7 12 11 19 Z M21 21 Q22 9 16 3 Q17 12 13 19 Z" fill="#ff5a4f" stroke="#000" stroke-opacity=".6" stroke-width="1.6" stroke-linejoin="round"/>';
+// an element holding the badge for a side; `cls` is its class
+export const sideGlyph = (evil, cls = 'sideGlyph') => {
+  const el = document.createElement('span');
+  el.className = cls;
+  el.dataset.side = evil ? 'evil' : 'good';
+  el.title = evil ? 'Evil' : 'Good';
+  el.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true">' + (evil ? HORNS : HALO) + '</svg>';
+  return el;
+};
diff --git a/src/delivery/sidecues.js b/src/delivery/sidecues.js
new file mode 100644
index 0000000..ab37c54
--- /dev/null
+++ b/src/delivery/sidecues.js
@@ -0,0 +1,13 @@
+// Good/Evil cue switches (12-Oct): ?ge=1,5,8 or ?ge=all turns ideas of IDEAS-good-evil-11-Oct.md on for a visit.
+let set = null;
+export function geOn(n) {
+  if (!set) {
+    set = new Set();
+    try {
+      const v = new URLSearchParams(location.search).get('ge');
+      if (v === 'all') for (let i = 1; i <= 12; i++) set.add(i);
+      else if (v) v.split(',').forEach((x) => { const k = parseInt(x, 10); if (k) set.add(k); });
+    } catch (e) { /* no location: all off */ }
+  }
+  return set.has(n);
+}
